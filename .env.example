# ============================================================================
#  LEF ERP — environment for docker compose
#  Copy this file to ".env" and change every password/secret before deploying.
#      cp .env.example .env
#  The .env file is git-ignored and never baked into the images.
# ============================================================================

# ---- Docker Hub (for build/push/pull) ----
# Your Docker Hub username or org. Images become:
#   <DOCKERHUB_USER>/lef-backend  and  <DOCKERHUB_USER>/lef-frontend
DOCKERHUB_USER=your-dockerhub-username
TAG=latest

# ---- Database (MariaDB) ----
DB_NAME=lef_payroll
DB_USER=lefapp
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
DB_PORT=3306

# ---- Backend API ----
BACKEND_PORT=5000
# Use a long random value:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Shared secret the Aura mobile backend uses to push clock in/out events.
# Must match LEF_SYNC_KEY in the mobile (Aura) backend's .env.
SYNC_API_KEY=change-me-mobile-sync-key
# Public URL where users reach the frontend (used for CORS)
FRONTEND_URL=http://localhost:8080

# ---- Frontend ----
FRONTEND_PORT=8080
# Leave as /api so the browser talks to nginx, which proxies to the backend.
VITE_API_URL=/api

# ---- phpMyAdmin ----
PMA_PORT=8081
