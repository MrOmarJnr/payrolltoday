# ============================================================================
#  LEF ERP — environment for docker compose
#  Copy this file to ".env" and change EVERY password/secret before deploying.
#      cp .env.example .env
#  The .env file is git-ignored and never baked into the images.
#
#  GOING LIVE ON A NEW SERVER: generate brand-new values for every secret
#  below (DB_PASSWORD, DB_ROOT_PASSWORD, JWT_SECRET, SYNC_API_KEY). Never
#  copy secrets over from a previous deployment, especially one that may
#  have been compromised — treat old values as burned.
#    openssl rand -base64 48
# ============================================================================

# ---- Docker Hub (for build/push/pull) ----
# Your Docker Hub username or org. Images become:
#   <DOCKERHUB_USER>/lef-backend  and  <DOCKERHUB_USER>/lef-frontend
DOCKERHUB_USER=your-dockerhub-username
TAG=latest

# ---- Domain (used by Caddy for automatic HTTPS) ----
# Point an A/AAAA record at this server's IP first, then set the real domain
# here. Leave as "localhost" only for local dev (no real TLS cert then).
DOMAIN=leflab.allrounditsol.com

# ---- Database (MariaDB) ----
DB_NAME=lef_payroll
DB_USER=lefapp
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
DB_PORT=3306

# ---- Backend API ----
# Use a long random value:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Shared secret the Aura mobile backend uses to push clock in/out events.
# Must match LEF_SYNC_KEY in the mobile (Aura) backend's .env.
SYNC_API_KEY=change-me-mobile-sync-key
# Public URL where users reach the app (used for CORS) — must match DOMAIN above, over https.
FRONTEND_URL=https://leflab.allrounditsol.com

# ---- Frontend ----
# Leave as /api so the browser talks to nginx, which proxies to the backend.
VITE_API_URL=/api

# ---- phpMyAdmin (optional — off unless you start it explicitly) ----
# docker compose --profile admin-tools up -d phpmyadmin
PMA_PORT=8081
